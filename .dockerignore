# Version control
.git
.gitignore

# Python bytecode
__pycache__
*.pyc
*.pyo
*.pyd
*.pdb

# Python packaging artifacts
*.egg-info
*.egg
dist/
build/

# Raw / processed data (regenerated by seed_demo.py at build time)
data/raw/
data/processed/

# Secrets — never bake into the image
.env
.env.*
google_service_key.json

# Frontend (deployed separately or served by a CDN)
frontend/

# Claude Code tooling
.claude/

# Pre-trained model checkpoints (regenerated at build / runtime)
models/

# Node
node_modules/

# Dev notebooks and local docs
notebooks/
phase2pocstagebriefingidea2_0/
docs/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

# Editor / OS
.DS_Store
*.swp
*.swo
